/* 超大数字 */
.tile-super {
  background: linear-gradient(145deg, #ffcc80, #ff6d00);
  box-shadow: inset 0 6rpx 12rpx rgba(255, 248, 225, 0.22), inset 0 -3rpx 8rpx rgba(0, 0, 0, 0.2), 0 0 28rpx rgba(255, 109, 0, 0.7);
  border-color: rgba(255, 183, 77, 0.6);
}
.tile-super .tile-text { color: #ffffff; font-size: 26rpx; text-shadow: 0 0 14rpx rgba(255, 109, 0, 0.5), 0 0 28rpx rgba(255, 109, 0, 0.2); }

/* 遮罩层 */
.game-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(28, 28, 28, 0.85);
  border-radius: 16rpx;
  z-index: 100;
  animation: fadeIn 300ms ease-in-out;
}

.overlay-won {
  background-color: rgba(230, 81, 0, 0.65);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.overlay-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #ffcc80;
  margin-bottom: 20rpx;
}

.overlay-score {
  font-size: 30rpx;
  color: #ff9100;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.overlay-record {
  font-size: 36rpx;
  font-weight: 900;
  color: #ffc400;
  margin-bottom: 24rpx;
  animation: record-pulse 600ms ease-in-out infinite;
}

@keyframes record-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.1); }
}

.overlay-btn {
  background-color: #e65100;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  margin-bottom: 16rpx;
}

.overlay-btn-text {
  font-size: 30rpx;
  color: #fff3e0;
  font-weight: 700;
}

.overlay-btn-secondary {
  background-color: #4e342e;
}

/* 操作提示 - 已替换为统计区 */

/* ====== 统计区域 ====== */
.stats-section {
  width: 640rpx;
  margin-top: 24rpx;
}

.stats-group-title {
  display: block;
  font-size: 22rpx;
  color: #8d6e63;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  margin-top: 20rpx;
}

.stats-group-title:first-child {
  margin-top: 0;
}

.stats-row {
  display: flex;
  gap: 12rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #1e1e1e;
  border-radius: 12rpx;
  border: 1rpx solid #2a2a2a;
  padding: 16rpx 8rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #5d4037;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 900;
  color: #ffcc80;
  line-height: 1.2;
}

.stat-value-orange {
  color: #ff9100;
}

.stat-value-mono {
  font-family: 'Menlo', 'Courier New', monospace;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.stat-value-gold {
  color: #ffc400;
}

.stat-value-sm {
  font-size: 26rpx;
  color: #8d6e63;
}

.stat-card-half {
  flex: 1;
  flex-direction: row;
  justify-content: space-between;
  padding: 16rpx 20rpx;
}

.stat-card-half .stat-label {
  margin-bottom: 0;
  align-self: center;
}

.stat-card-half .stat-value {
  align-self: center;
}

.stat-card-third {
  flex: 1;
  flex-direction: row;
  justify-content: space-between;
  padding: 14rpx 20rpx;
}

.stat-card-third .stat-label {
  margin-bottom: 0;
  align-self: center;
}

.stat-card-third .stat-value {
  align-self: center;
}

/* ====== 礼花粒子特效 ====== */
.fireworks-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
}

.firework-particle {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  opacity: 0;
  animation: firework-burst ease-out both;
}

@keyframes firework-burst {
  0% {
    opacity: 1;
    transform: scale(0) translate(0, 0);
  }
  30% {
    opacity: 1;
    transform: scale(1.2);
  }
  100% {
    opacity: 0;
    transform: scale(0.6) translate(var(--dx, 0), var(--dy, 40rpx));
  }
}

.firework-color-0 { background-color: #ff6d00; }
.firework-color-1 { background-color: #ffc400; }
.firework-color-2 { background-color: #ff3d00; }
.firework-color-3 { background-color: #e040fb; }
.firework-color-4 { background-color: #00e5ff; }

/* ====== 作者信息 ====== */
.author-info {
  width: 640rpx;
  margin-top: 36rpx;
  padding-bottom: 40rpx;
  text-align: center;
}

.author-text {
  font-size: 22rpx;
  color: #5d4037;
  font-weight: 500;
  letter-spacing: 2rpx;
  opacity: 0.7;
}
