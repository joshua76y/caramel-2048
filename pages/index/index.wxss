/* ====== 七段数码管字体 ====== */
@font-face {
  font-family: 'DSEG7';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: normal;
  font-style: normal;
}

/* ====== 熔岩暗黑配色方案 ====== */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #121212;
  padding: 30rpx 0;
}

/* 头部区域 */
.header {
  width: 640rpx;
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

/* ====== 焦糖2048 LOGO - 大方块两行 ====== */
.logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 14rpx 28rpx 16rpx;
  background: linear-gradient(150deg, #e65100 0%, #bf360c 35%, #6d4c41 100%);
  border: 2rpx solid rgba(255, 183, 77, 0.55);
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 224, 178, 0.25),
    inset 0 -3rpx 8rpx rgba(0, 0, 0, 0.3),
    0 3rpx 16rpx rgba(230, 81, 0, 0.5),
    0 0 24rpx rgba(255, 160, 0, 0.2);
  position: relative;
  overflow: hidden;
}

/* 糖浆光泽覆盖 */
.logo::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 16rpx;
  background: linear-gradient(
    165deg,
    rgba(255, 224, 178, 0.4) 0%,
    rgba(255, 224, 178, 0.18) 25%,
    transparent 50%,
    rgba(0, 0, 0, 0.06) 100%
  );
  pointer-events: none;
}

/* 顶部反光线 */
.logo::before {
  content: '';
  position: absolute;
  top: 5rpx; left: 14rpx; right: 14rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(
    90deg, transparent,
    rgba(255, 235, 200, 0.6) 20%,
    rgba(255, 248, 230, 0.8) 50%,
    rgba(255, 235, 200, 0.6) 80%,
    transparent
  );
  pointer-events: none;
  z-index: 5;
}

.logo-line1 {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
}

.logo-line2 {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  margin-top: 0rpx;
}

.logo-char {
  font-size: 32rpx;
  font-weight: 900;
  color: #ffe0b2;
  letter-spacing: 8rpx;
  text-shadow:
    0 0 8rpx rgba(255, 183, 77, 0.7),
    0 0 20rpx rgba(255, 152, 0, 0.3);
}

.logo-num {
  font-family: 'DSEG7', 'Menlo', 'Courier New', monospace;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3rpx;
  text-shadow:
    0 0 8rpx rgba(255, 183, 77, 0.8),
    0 0 18rpx rgba(255, 152, 0, 0.4),
    0 0 32rpx rgba(255, 111, 0, 0.15);
}

.scores {
  display: flex;
  gap: 12rpx;
}

.score-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #2a2a2a;
  border-radius: 12rpx;
  padding: 10rpx 28rpx;
  min-width: 120rpx;
  border: 1rpx solid #3a3a3a;
}

.score-label {
  font-size: 22rpx;
  color: #8d6e63;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #ffcc80;
}

.subtitle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.subtitle {
  font-size: 26rpx;
  color: #8d6e63;
  font-weight: 600;
}

.btn-new-game {
  background-color: #e65100;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #fff3e0;
  font-weight: 700;
}

/* 游戏面板 */
.game-board {
  position: relative;
  width: 640rpx;
  height: 640rpx;
  background-color: #1c1c1c;
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #2a2a2a;
}

/* 背景网格 */
.grid-bg {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  gap: 16rpx;
  width: 100%;
  height: 100%;
}

.grid-cell {
  background-color: #2a2a2a;
  border-radius: 12rpx;
}

/* 方块层 */
.tiles-layer {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
}

/* 方块基础样式 */
.tile {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  width: 140rpx;
  height: 140rpx;
  transition: left 130ms ease-in-out, top 130ms ease-in-out;
  z-index: 10;
  border: 2rpx solid rgba(255, 183, 77, 0.35);
  box-shadow:
    inset 0 6rpx 12rpx rgba(255, 224, 178, 0.12),
    inset 0 -3rpx 8rpx rgba(0, 0, 0, 0.3),
    inset 2rpx 0 6rpx rgba(255, 224, 178, 0.06),
    inset -2rpx 0 6rpx rgba(0, 0, 0, 0.15);
}

/* 糖浆光泽覆盖层 - 增强版 */
.tile::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: linear-gradient(
    165deg,
    rgba(255, 224, 178, 0.4) 0%,
    rgba(255, 224, 178, 0.2) 20%,
    rgba(255, 224, 178, 0.05) 40%,
    transparent 55%,
    rgba(0, 0, 0, 0.1) 100%
  );
  pointer-events: none;
}

/* 糖浆高光线 - 顶部反光条 */
.tile::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 16rpx;
  right: 16rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 235, 200, 0.5) 20%,
    rgba(255, 235, 200, 0.6) 50%,
    rgba(255, 235, 200, 0.5) 80%,
    transparent
  );
  pointer-events: none;
  z-index: 5;
}

.tile-text {
  font-family: 'DSEG7', 'Menlo', 'Courier New', monospace;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 10;
}

/* ====== 合并时数字跳动动画 ====== */
.tile-text-merged {
  animation: num-bounce 350ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes num-bounce {
  0% {
    transform: scale(1) translateY(0);
    opacity: 0.6;
  }
  25% {
    transform: scale(1.35) translateY(-8rpx);
    opacity: 1;
  }
  50% {
    transform: scale(0.95) translateY(3rpx);
    opacity: 1;
  }
  75% {
    transform: scale(1.08) translateY(-2rpx);
    opacity: 1;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* ====== 滑动动画 ====== */

/* ====== 新方块出现动画 ====== */
.tile-new {
  animation: tile-appear 200ms ease 80ms both;
}

@keyframes tile-appear {
  0% {
    opacity: 0;
    transform: scale(0);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ====== 合并弹跳动画 ====== */
.tile-merged {
  animation: tile-pop 200ms ease 0ms both;
  z-index: 20;
}

@keyframes tile-pop {
  0% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.25);
  }
  100% {
    transform: scale(1);
  }
}

